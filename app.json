{
  "expo": {
    "name": "Wellnest",
    "slug": "calhacks-health",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "health.talktothebeak.wellnest"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Wellnest",
      "shortName": "Wellnest"
    },
    "plugins": [
      "expo-secure-store",
      "expo-audio",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Wellnest reads daily summaries of your sleep, activity, heart rate, breathing, temperature, weight and cycle so it can use them when answering your health questions.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wellnest uses your photos when you choose one to ask about, like a pill bottle, a label or lab results.",
          "cameraPermission": "Wellnest uses the camera when you take a photo to ask about, like a pill bottle or a rash.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
