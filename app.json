{
  "expo": {
    "name": "Wellnest",
    "slug": "calhacks-health",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "health.talktothebeak.wellnest"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "health.talktothebeak.wellnest",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_MENSTRUATION"
      ]
    },
    "web": {
      "name": "Wellnest",
      "shortName": "Wellnest",
      "description": "Wellnest is an AI health companion you can talk to. It remembers what matters, finds your patterns, keeps track of your medicines and keeps the people who care for you in the loop.",
      "themeColor": "#0B5D57"
    },
    "plugins": [
      "expo-secure-store",
      "expo-audio",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Wellnest reads daily summaries of your sleep, activity, heart rate, breathing, temperature, weight, glucose, and cycle so it can use them when answering your health questions.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wellnest uses your photos when you choose one to ask about, like a pill bottle, a label or lab results.",
          "cameraPermission": "Wellnest uses the camera when you take a photo to ask about, like a pill bottle or a rash.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B5D57"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wellnest uses your location only when you ask it to find care nearby."
        }
      ],
      "expo-sharing"
    ]
  }
}
